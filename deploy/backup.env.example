# Install as /etc/furniture-backup.env, owner root, mode 600. Never commit real keys.
APP_DIR=/var/www/furniture-shop
BACKEND_SERVICE=furniture-backend.service
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=furniture_shop
PGUSER=furniture
PGSSLMODE=require
PGPASSFILE=/etc/furniture-backup.pgpass
# Separate bucket/repository for this site. Do not enable S3 age-based deletion.
RESTIC_REPOSITORY=s3:https://YOUR-S3-ENDPOINT/YOUR-BUCKET/furniture-shop
RESTIC_PASSWORD_FILE=/etc/furniture-restic-password
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=us-east-1
